# 填写服务端模型凭据；不要将本文件的真实配置上传到公开仓库。
XIAOJING_API_KEY=
CUOTI_AI_USE_ENV_PROXY=false
# 仅旧库缺少历史升级时显式启用；升级命令会先备份到数据卷中。
CUOTI_UPGRADE_DB=false
# 仅对全新空库生效；24 道演示题不包含学生资料。
CUOTI_DEMO_DATA=true
# 默认使用镜像内公开配置，可用挂载文件替换模型池。
# CUOTI_API_POOL_PATH=/data/api_pool.json
# 核心镜像可使用外部 BGE HTTP 服务，完整镜像内置 CPU BGE。
# CUOTI_RETRIEVAL_INFERENCE_URL=http://retrieval:8011
