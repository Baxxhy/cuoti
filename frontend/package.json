{
  "name": "minddimension-uniapp",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "uni",
    "dev:h5": "uni",
    "dev:app": "uni -p app",
    "build": "uni build",
    "build:h5": "uni build",
    "build:app": "uni build -p app",
    "build:app:local": "uni build -p app --mode development",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests e2e *.ts *.js",
    "format:check": "prettier --check src tests e2e *.ts *.js"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-4080720251210001",
    "@dcloudio/uni-app-plus": "3.0.0-4080720251210001",
    "@dcloudio/uni-components": "3.0.0-4080720251210001",
    "@dcloudio/uni-h5": "3.0.0-4080720251210001",
    "@dcloudio/uni-ui": "^1.4.26",
    "katex": "^0.16.22",
    "pinia": "^2.3.1",
    "vue": "^3.4.21"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.4.8",
    "@dcloudio/uni-automator": "3.0.0-4080720251210001",
    "@dcloudio/uni-cli-shared": "3.0.0-4080720251210001",
    "@dcloudio/vite-plugin-uni": "3.0.0-4080720251210001",
    "@playwright/test": "^1.54.0",
    "@types/node": "25.0.9",
    "@uni-helper/vite-plugin-uni-components": "^0.2.6",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "prettier": "3.6.2",
    "sass": "^1.97.2",
    "typescript": "^5.9.3",
    "vite": "5.2.8",
    "vitest": "^3.0.7"
  },
  "packageManager": "pnpm@11.20.0"
}
