# 复制为 .env.python；已有 .env.cangjie 仍可读取，不会重置数据库或登录密钥。
CUOTI_DB_HOST=127.0.0.1
CUOTI_DB_PORT=3307
CUOTI_DB_NAME=cuoti_local
CUOTI_DB_USER=cuoti_local
CUOTI_DB_PASSWORD='replace-with-your-local-database-password'
CUOTI_HOST=127.0.0.1
CUOTI_PORT=8002
ZHIWEI_FRONTEND_PORT=5175
CUOTI_LEARNING_TASK_WORKER_ENABLED=true
# 新项目默认使用项目目录下的 media；迁移时请指向原有 media 目录。
# CUOTI_MEDIA_ROOT=/absolute/path/to/existing/media
# CUOTI_API_POOL_PATH=/absolute/path/to/config/api_pool.json
CUOTI_AI_USE_ENV_PROXY=true
CUOTI_QDRANT_URL=http://127.0.0.1:6333
CUOTI_QDRANT_COLLECTION=cuoti_local_questions_v1
CUOTI_RETRIEVAL_INFERENCE_URL=http://127.0.0.1:8011
# 密钥可在首次 make dev 时自动生成并保存在 .runtime；不要提交真实密钥。
# CUOTI_AUTH_SECRET=
# CUOTI_ALGORITHM_SECRET=
