DATABASE_URL=mysql+asyncmy://minddimension:minddimension@127.0.0.1:3307/minddimension
# 如默认端口被其他项目占用，可分别改为 8001 和 5174。
ZHIWEI_BACKEND_PORT=8000
ZHIWEI_FRONTEND_PORT=5173
API_POOL_PATH=backend/config/api_pool.json
AI_LOGICAL_MODEL=Qwen
UPLOAD_DIR=uploads
AI_MODE=live
AUTH_SECRET=minddimension-local-session-secret
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=minddimension_questions_v1
RETRIEVAL_INFERENCE_URL=http://127.0.0.1:8011
RETRIEVAL_CONDA_ENV=minddimension-retrieval
# 仅在复用其他环境并使用项目内兼容包时设置，不影响后端主进程。
RETRIEVAL_PYTHONPATH=
RETRIEVAL_EMBEDDING_MODEL=BAAI/bge-m3
RETRIEVAL_EMBEDDING_DIMENSION=1024
RETRIEVAL_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RETRIEVAL_MODEL_CACHE=.models/bge
# 留空时自动选择：双卡使用 cuda:0/cuda:1，单卡共用 cuda:0，无 GPU 使用 CPU。
RETRIEVAL_EMBEDDING_DEVICE=
RETRIEVAL_RERANKER_DEVICE=
RETRIEVAL_BATCH_SIZE=16
RETRIEVAL_MAX_LENGTH=512
RETRIEVAL_CANDIDATE_LIMIT=50
RETRIEVAL_RESULT_LIMIT=10
