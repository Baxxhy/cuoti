# Copy to .env.cangjie. This file is sourced by bash; keep it local and trusted.
# Provision a separate MySQL account/database, then run init-db once explicitly.
CANGJIE_DB_HOST=127.0.0.1
CANGJIE_DB_PORT=3307
CANGJIE_DB_NAME=zhiwei_cangjie
CANGJIE_DB_USER=zhiwei_cangjie
CANGJIE_DB_PASSWORD='replace-with-your-local-database-password'
CANGJIE_BACKEND_PORT=8002
CANGJIE_ALGORITHM_PORT=8012
ZHIWEI_FRONTEND_PORT=5175
# Must use this database's prefix; keep independent question indexes for each database.
CANGJIE_QDRANT_COLLECTION=zhiwei_cangjie_questions_v1
# API pool stays on the backend. Never copy pool credentials into frontend env.
# CANGJIE_API_POOL_PATH=/absolute/path/to/config/api_pool.json
# Set false only when the environment proxy is unavailable and the pool is directly reachable.
CANGJIE_AI_USE_ENV_PROXY=true

# 本地维护管理员（学生使用注册页；不支持老师/家长身份）：
# bash scripts/local_user.sh --email admin@example.com --role admin --name 本地维护
